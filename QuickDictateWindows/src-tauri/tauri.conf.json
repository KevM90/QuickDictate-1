{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickDictate",
  "version": "1.0.0",
  "identifier": "app.quickdictate.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "QuickDictate",
        "width": 340,
        "height": 480,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "QuickDictate – Einstellungen",
        "width": 480,
        "height": 620,
        "resizable": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "tooltip": "QuickDictate",
      "iconAsTemplate": false
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
